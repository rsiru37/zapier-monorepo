#######################################################################################
# syntax=docker/dockerfile:1
FROM oven/bun:1-alpine AS builder       
WORKDIR /app

RUN apk add --no-cache openssl

# Copy only what's needed for install & build (good caching)
COPY package.json bun.lock turbo.json ./
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

RUN bun install --frozen-lockfile
RUN bun add -d @types/react @types/node
RUN cd apps/web && bun run build

# ──────────────────────────────────────────────────────────────
# Production stage (tiny image)
FROM oven/bun:1-alpine AS runner
WORKDIR /app

# Only copy the built output + minimal runtime files
COPY --from=builder /app/apps/web/.next          ./.next
COPY --from=builder /app/apps/web/public         ./public
COPY --from=builder /app/apps/web/package.json   ./package.json
COPY --from=builder /app/apps/web/node_modules   ./node_modules   
COPY --from=builder /app/bun.lock                ./bun.lock
COPY --from=builder /app/package.json            ./package.json

# If you use environment variables at runtime
# ENV NODE_ENV=production

EXPOSE 3000
CMD ["bun", "run", "start:frontend"]