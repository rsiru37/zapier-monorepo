generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Action {
  id                String             @id @default(uuid())
  action_name_id    String
  zap_id            String?
  metadata          Json?            @default("{}")
  Available_Actions Available_Actions @relation(fields: [action_name_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "action_name_id is a fkey")
  zap               zap?               @relation(fields: [zap_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "zap_id is a fkey")
  sortingOrder      Int        @default(0)
}

model Available_Actions {
  id     String   @id @default(uuid())
  name   String?
  image  String?
  Action Action[]

  @@map("Available Actions")
}

model Available_Triggers {
  id           String    @id @default(uuid())
  trigger_name String
  image        String?
  Trigger      Trigger[]

  @@map("Available Triggers")
}

model Trigger {
  id                 String              @id @default(uuid())
  trigger_id         String?
  Available_Triggers Available_Triggers? @relation(fields: [trigger_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "trigger_id is a fkey")
  zap                zap[]
}
 
model User {
  id       Int     @id @default(autoincrement())
  name     String?
  email    String? @unique
  password String?
  zaps     zap[]
}

model zap {
  id         String    @id @default(uuid())
  trigger_id String
  user_id    Int
  Action     Action[]
  Trigger    Trigger   @relation(fields: [trigger_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "trigger_id will be a fkey")
  zap_run    zap_run[]
  user       User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_id is a fkey")

}

model zap_run {
  id             String           @id @default(uuid())
  zap_id         String?
  metadata       Json?            @db.Json
  zap            zap?             @relation(fields: [zap_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "zap_id is a fkey")
  zap_run_outbox zap_run_outbox[]

  @@map("zap run")
}

model zap_run_outbox {
  id         String   @id @default(uuid())
  zap_run_id String?
  zap_run    zap_run? @relation(fields: [zap_run_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "zap_run_id is a fkey")

  @@map("zap run outbox")
}
