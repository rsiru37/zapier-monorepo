{
  "name": "zapier-monorepo",
  "private": true,
  "scripts": {
    "start:backend":"cd apps/primary_backend && bun run src/index.ts",
    "start:frontend":"cd apps/web && bun run start",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate":"cd packages/db && bun prisma generate && cd ../..",
    "db:migrate":"cd packages/db && bun prisma migrate deploy && cd ../.."
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/client": "5",
    "prisma": "5"
  }
}
